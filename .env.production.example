# Production. With the Docker stack, use infra/deploy/server.env.example instead
# (compose sets hosts, ports and TRUST_PROXY). Prefer a secret manager over a
# file; if you use a file, keep it on the server only (chmod 600, never commit).
# Production enforces: https SUPABASE_URL, TLS to the database, info-level logs,
# un-relaxed rate limits.
APP_ENV=production
SUPABASE_URL=https://wqomqigjotnkdlheccxl.supabase.co
SUPABASE_ANON_KEY=
# Prefer the least-privilege role kestrel_api (role created 2026-10-08; set its password
# first, see supabase/migrations-pending/README.md) (docs/deployment.md#database-role).
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=supabase/certs/prod-ca-2021.crt
API_HOST=0.0.0.0
API_PORT=8080
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8081
# TURN over TLS is required in production when TURN is configured.
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turns:turn.example.com:5349?transport=tcp,turn:turn.example.com:3478?transport=udp
TURN_SECRET=
# Number of trusted proxies in front (Caddy = 1). Never expose the service
# ports directly when this is > 0, or X-Forwarded-For could be forged.
TRUST_PROXY=1
