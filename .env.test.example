# Automated tests need NO environment file: unit and integration tests run
# against an in-process Postgres (PGlite) with the real migrations, a fake
# Supabase Auth and ephemeral ports. They never contact a Supabase project.
#
# This file documents the test profile for anyone running a server manually
# with APP_ENV=test (silent logs, strict rate limits, DATABASE_URL optional).
APP_ENV=test
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=test-anon-key-not-a-secret-000000
SUPABASE_JWT_SECRET=test-only-jwt-secret-that-is-long-enough-0123456789
