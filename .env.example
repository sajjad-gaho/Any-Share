# Server configuration for apps/api and apps/signaling.
#
# Copy to `.env.development` (local), `.env.production` (deploy) or use real
# environment variables. Files are loaded as `.env.<APP_ENV>.local`,
# `.env.<APP_ENV>`, then `.env`, from the app directory and the repo root;
# variables already set in the environment always win.
#
# NEVER commit real values. `.env` and `.env.*` are git-ignored (only the
# `*.example` files are tracked). None of these values go into the Electron app:
# the desktop client only knows the public API URL (apps/desktop/.env.example).
# The Supabase service-role key is not used anywhere in this project.

# development | test | production. Selects defaults (log level, TLS, rate limits).
APP_ENV=development
# fatal | error | warn | info | debug | trace | silent (default depends on APP_ENV)
# LOG_LEVEL=debug

# --- Supabase project: PBS-DESKTOP (ref wqomqigjotnkdlheccxl) -----------------
SUPABASE_URL=https://wqomqigjotnkdlheccxl.supabase.co
# Publishable (anon) key from Dashboard > Project Settings > API Keys. Public, but
# keep it in config rather than code.
SUPABASE_ANON_KEY=
# Only if the project still uses the legacy shared JWT secret. Leave empty to
# verify tokens with the project's JWKS (asymmetric signing keys).
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUDIENCE=authenticated

# --- Database (SECRET) ----------------------------------------------------------
# Dashboard > Connect > Session pooler. Contains the database password.
DATABASE_URL=postgresql://postgres.wqomqigjotnkdlheccxl:[YOUR-DB-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
# The services use the least-privilege role: user `kestrel_api.<project-ref>`
# (supabase/migrations/20261008000200_api_role.sql). Its password is set once
# as a SCRAM verifier and lives only here / in server.env.
#
# Privileged URL (user postgres.<project-ref>) for `supabase db push --db-url`
# schema migrations ONLY. The services never read it; never put it on a server.
# MIGRATIONS_DATABASE_URL=
# TLS to the database: defaults to true in production, false otherwise.
# DATABASE_SSL=true
# Supabase's pooler certificate is issued by the self-signed "Supabase Root 2021 CA".
# Pin it (verification is never disabled). Relative paths resolve from the app dir, then repo root.
DATABASE_SSL_CA_FILE=supabase/certs/prod-ca-2021.crt
# DATABASE_POOL_MAX=10

# --- HTTP API -------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8080
# Number of trusted reverse proxies in front of the service (0 = none; Caddy = 1).
# The client IP is read that many entries from the RIGHT of X-Forwarded-For, so
# a client-supplied header cannot spoof it. `true` = 1, `false` = 0.
TRUST_PROXY=0

# --- Signaling ------------------------------------------------------------------
SIGNALING_HOST=127.0.0.1
SIGNALING_PORT=8081
# WebSocket ping interval; a socket that misses one pong is dropped.
HEARTBEAT_INTERVAL_MS=15000
# last_seen_at is written in one batched UPDATE per interval, never per heartbeat.
PRESENCE_FLUSH_INTERVAL_MS=30000

# --- WebRTC (STUN/TURN) ---------------------------------------------------------
# Empty = direct connections only (LAN / same machine). See infra/coturn/README.md.
# STUN_URLS=stun:127.0.0.1:3478
# TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
# Shared with coturn's static-auth-secret. SECRET. Required when TURN_URLS is set.
# TURN_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=3600
# Approved sessions must reach CONNECTED within this many seconds.
# SESSION_CONNECT_TIMEOUT_SECONDS=90
# A participant may be gone from signaling this long before its sessions fail.
# PEER_DISCONNECT_GRACE_SECONDS=30

# --- Sessions -------------------------------------------------------------------
# Pending connection requests expire after this many seconds (10-600).
CONNECTION_REQUEST_TTL_SECONDS=60

# --- Rate limits ----------------------------------------------------------------
# Scales every per-IP / per-account budget. Default per APP_ENV (development 5,
# test 1, production 1). Production may only tighten it (<= 1); load tests on a
# local stack may raise it.
# RATE_LIMIT_MULTIPLIER=1
