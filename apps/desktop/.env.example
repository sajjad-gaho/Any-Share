# Desktop build configuration (electron-vite). PUBLIC values only: anything
# here is compiled into the app. Never put a Supabase key, database URL or
# any other secret in this file.
#
# Copy to `.env.development` / `.env.production` in apps/desktop.

# Base URL of apps/api. Development defaults to http://127.0.0.1:8080 when unset;
# packaged builds require https and have no default.
MAIN_VITE_API_URL=http://127.0.0.1:8080

# Signaling WebSocket. Development defaults to ws://127.0.0.1:8081/ws when unset;
# packaged builds require wss:.
MAIN_VITE_SIGNALING_URL=ws://127.0.0.1:8081/ws

# LAN TEST BUILDS ONLY. `true` lets this build use plain http/ws to a private
# LAN address (10.x, 172.16-31.x, 192.168.x), e.g.
#   MAIN_VITE_API_URL=http://192.168.1.10:8080
#   MAIN_VITE_SIGNALING_URL=ws://192.168.1.10:8081/ws
# Traffic to the servers (including sign-in) is then unencrypted on the local
# network. Use only on a trusted home network with test accounts, and never
# distribute such a build. Public hosts and domain names still require https/wss.
# MAIN_VITE_ALLOW_LAN_HTTP=true
