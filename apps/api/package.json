{
  "name": "@remote-desktop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API (Fastify): auth, users, organizations, devices, permissions, sessions, connection requests, audit, health.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node ../../scripts/build-server.mjs src/main.ts dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@remote-desktop/backend": "workspace:*",
    "@remote-desktop/shared": "workspace:*",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
