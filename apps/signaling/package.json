{
  "name": "@remote-desktop/signaling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated WebSocket signaling service: connection requests, WebRTC negotiation relay, session control, device presence.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node ../../scripts/build-server.mjs src/main.ts dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@remote-desktop/backend": "workspace:*",
    "@remote-desktop/shared": "workspace:*",
    "@remote-desktop/webrtc": "workspace:*",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
