# Local development. Copy to `.env.development` and fill in the blanks.
# See .env.example for every variable.
APP_ENV=development
SUPABASE_URL=https://wqomqigjotnkdlheccxl.supabase.co
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres.wqomqigjotnkdlheccxl:[YOUR-DB-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
# The Supabase pooler requires TLS even locally.
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=supabase/certs/prod-ca-2021.crt
API_HOST=127.0.0.1
API_PORT=8080
SIGNALING_HOST=127.0.0.1
SIGNALING_PORT=8081
