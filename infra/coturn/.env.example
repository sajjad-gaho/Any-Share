# Copy to infra/coturn/.env (git-ignored). Development values only.
#
# Shared secret between coturn and apps/signaling (TURN REST API). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# and put the same value in TURN_SECRET of the repository's .env.development.
TURN_SECRET=

# Address clients use to reach relayed ports. 127.0.0.1 for two clients on
# this machine; your LAN IP to test from another computer on the network.
TURN_EXTERNAL_IP=127.0.0.1
