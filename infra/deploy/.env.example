# docker compose variables for infra/deploy (NOT secret). Copy to .env.
# DNS: A/AAAA records for both names must point at this server before start-up,
# otherwise certificate issuance fails.
API_DOMAIN=api.example.com
SIGNAL_DOMAIN=signal.example.com
# Contact address for the certificate authority (expiry notices).
ACME_EMAIL=ops@example.com

# Image tags. Build on the server (`docker compose build`) or push versioned
# images from CI and pin them here; roll back by restoring the previous tag.
API_IMAGE=kestrel-api:0.1.0
SIGNALING_IMAGE=kestrel-signaling:0.1.0
