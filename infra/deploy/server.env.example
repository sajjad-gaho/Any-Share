# Application configuration for the API and signaling containers.
# Copy to server.env on the server ONLY, `chmod 600 server.env`, never commit.
# Every variable is validated at start-up (see .env.example at the repo root);
# a bad value stops the service with the variable NAME (never the value).
#
# Set by docker-compose.yml, do not repeat here:
#   APP_ENV=production, API_HOST/PORT, SIGNALING_HOST/PORT, TRUST_PROXY=1,
#   DATABASE_SSL_CA_FILE (baked into the image: Supabase root CA).

# --- Supabase (public project identifiers) ----------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key. Not a secret, but keep it in configuration.
SUPABASE_ANON_KEY=

# --- Database (SECRET) -------------------------------------------------------
# Session pooler URL (port 5432). Use a dedicated least-privilege role once its password
# is set (supabase/migrations-pending/README.md) (docs/deployment.md).
DATABASE_URL=
# TLS is mandatory in production (verification always on, CA pinned).
DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# --- WebRTC / TURN (SECRET: TURN_SECRET) --------------------------------------
STUN_URLS=stun:turn.example.com:3478
# At least one turns: (TLS) URL is required in production.
TURN_URLS=turns:turn.example.com:5349?transport=tcp,turn:turn.example.com:3478?transport=udp
# Same value as coturn's static-auth-secret (infra/coturn). 32+ characters.
TURN_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Optional tuning -----------------------------------------------------------
# LOG_LEVEL=info
# CONNECTION_REQUEST_TTL_SECONDS=60
# SESSION_CONNECT_TIMEOUT_SECONDS=90
# PEER_DISCONNECT_GRACE_SECONDS=30
