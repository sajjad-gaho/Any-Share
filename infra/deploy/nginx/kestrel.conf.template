# Kestrel Remote behind an existing nginx (shared VPS).
#
# One NEW site file; no other nginx file is touched. Install:
#   sed 's/__DOMAIN__/any-desk.example.com/g' kestrel.conf.template \
#     > /etc/nginx/sites-available/<domain>.conf
#   ln -s /etc/nginx/sites-available/<domain>.conf /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx          # reload only if the test passes
#   certbot --nginx -d <domain>                 # adds HTTPS to THIS server block only
#
#   https://__DOMAIN__/api/v1/*  -> 127.0.0.1:18080  (Kestrel API)
#   wss://__DOMAIN__/ws          -> 127.0.0.1:18081  (Kestrel signaling)

# WebSocket upgrade helper. Uniquely named so it cannot clash with a
# `$connection_upgrade` map defined by another site.
map $http_upgrade $kestrel_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name __DOMAIN__;

    server_tokens off;
    # Same limit as the API (64 KiB): larger bodies never reach Node.
    client_max_body_size 64k;

    # The API sets CSP, X-Frame-Options, nosniff, Referrer-Policy and no-store
    # itself; nginx adds only HSTS (browsers ignore it on plain HTTP).
    add_header Strict-Transport-Security "max-age=31536000" always;

    # REST API (and its health probes).
    location /api/v1/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replace, never append: the API trusts exactly one proxy hop (TRUST_PROXY=1).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~ ^/health(/ready)?$ {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Signaling WebSocket. Long-lived: the server pings every 15 s.
    location = /ws {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $kestrel_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Nothing else is served on this host name.
    location / {
        return 404;
    }
}
