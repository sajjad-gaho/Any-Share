{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**", "target/release/kestrel-helper.exe"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/**"]
    },
    "test:integration": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "package:win": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false
    }
  }
}
